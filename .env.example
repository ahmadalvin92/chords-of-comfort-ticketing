# ===================================================================
# LSPR COMM30-6SP THEATER TICKETING SYSTEM - ENVIRONMENT VARIABLES
# ===================================================================

# 1. MIDTRANS PAYMENT GATEWAY
# Dapatkan dari Dashboard Midtrans: https://dashboard.midtrans.com/settings/access_keys
# Gunakan Sandbox untuk pengujian, Production untuk hari penjualan tiket asli.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_PRODUCTION=false

# 2. EMAIL SERVICE (RESEND)
# Dapatkan dari: https://resend.com/api-keys (Gratis 3.000 email/bulan)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
TICKET_FROM_EMAIL=tickets@lsprcomm30-6sp.com

# 3. SUPABASE (OPTIONAL FOR CLOUD DB DEPLOYMENT)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. APP BASE URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

